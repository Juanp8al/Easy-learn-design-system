# Copie este archivo a .env y ajuste los valores.
# EasyLearn — variables de entorno

# Obligatorio en producción (generar una clave larga y aleatoria)
DJANGO_SECRET_KEY=change-me-in-production

# Desarrollo local
DEBUG=True
DEVELOPMENT_MODE=True
LOCAL_SERVER=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos (solo si DEVELOPMENT_MODE=False)
# DATABASE_URL=postgres://user:pass@host:5432/easylearn
