# Django
DJANGO_SECRET_KEY=change-me
DEBUG=True
DEVELOPMENT_MODE=True
LOCAL_SERVER=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Database
# In development, DEVELOPMENT_MODE=True uses SQLite.
# In production, set DEVELOPMENT_MODE=False and provide DATABASE_URL.
DATABASE_URL=postgres://user:password@localhost:5432/easylearn

# Static/media storage
# Configure these only when using external object storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
